<Window x:Class="SmartFinanceManager.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:SmartFinanceManager.Helpers"
        mc:Ignorable="d"
        Style="{StaticResource DarkWindowStyle}"
        Title="Register - Smart Finance Manager" 
        Height="680" Width="440"
        MinWidth="380" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Border Background="{DynamicResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="{DynamicResource NavigationBrush}" Height="42" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Smart Finance Manager - Register" 
                           Foreground="{DynamicResource TextMutedBrush}" 
                           FontSize="11" 
                           VerticalAlignment="Center" 
                           Margin="16,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Content="🗖" 
                            Background="Transparent" 
                            Foreground="{DynamicResource TextMutedBrush}" 
                            BorderThickness="0" 
                            FontSize="13" 
                            Margin="0,0,12,0" 
                            Cursor="Hand"
                            Click="MaximizeButton_Click"/>
                    <Button Content="✕" 
                            Background="Transparent" 
                            Foreground="{DynamicResource TextMutedBrush}" 
                            BorderThickness="0" 
                            FontSize="14" 
                            Cursor="Hand"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Centered Register Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MaxWidth="400" Margin="24,12,24,20" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Brand Logo & Header -->
                        <RowDefinition Height="Auto"/> <!-- Form Fields -->
                        <RowDefinition Height="Auto"/> <!-- Buttons Actions -->
                    </Grid.RowDefinitions>

                    <!-- Brand Logo & Header -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <!-- App Icon -->
                        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,8">
                            <Path Data="{StaticResource IconAppLogo}" Fill="White" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Create Account" Style="{StaticResource TitleTextStyle}" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="Smart Finance Manager Suite" Style="{StaticResource SubtitleTextStyle}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Form Fields -->
                    <StackPanel Grid.Row="1">
                        <!-- Full Name Field Structured Card -->
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="👤" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="FULL NAME" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="Transparent" BorderThickness="0" Padding="0" 
                                             FontSize="13" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Email Field Structured Card -->
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="✉" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="EMAIL ADDRESS" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="Transparent" BorderThickness="0" Padding="0" 
                                             FontSize="13" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Account Type Mode Radio Selection -->
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="ACCOUNT TYPE" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Personal Radio -->
                                    <RadioButton Grid.Column="0" 
                                                 Content="Personal Mode" 
                                                 IsChecked="{Binding AccountType, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Personal}" 
                                                 Style="{StaticResource TabRadioButtonStyle}" 
                                                 Height="30" 
                                                 FontSize="11"/>

                                    <!-- Office Radio -->
                                    <RadioButton Grid.Column="2" 
                                                 Content="Office Mode" 
                                                 IsChecked="{Binding AccountType, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Office}" 
                                                 Style="{StaticResource TabRadioButtonStyle}" 
                                                 Height="30" 
                                                 FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Password Field Structured Card with Eye Toggle -->
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔒" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="PASSWORD (MIN 6 CHARS)" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                                    <Grid>
                                        <PasswordBox x:Name="PasswordInput" 
                                                     Background="Transparent" BorderThickness="0" Padding="0"
                                                     FontSize="13" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                        <TextBox x:Name="VisiblePasswordInput" 
                                                 Background="Transparent" BorderThickness="0" Padding="0"
                                                 FontSize="13" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </StackPanel>
                                <Button Grid.Column="2" 
                                        Content="👁" 
                                        Click="TogglePassword_Click" 
                                        VerticalAlignment="Center" 
                                        Background="Transparent" 
                                        Foreground="{DynamicResource TextMutedBrush}" 
                                        BorderThickness="0" 
                                        FontSize="14" 
                                        Margin="4,0,0,0" 
                                        Cursor="Hand"
                                        ToolTip="Toggle Password Visibility"/>
                            </Grid>
                        </Border>

                        <!-- Confirm Password Field Structured Card -->
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔒" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="CONFIRM PASSWORD" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                                    <Grid>
                                        <PasswordBox x:Name="ConfirmPasswordInput" 
                                                     Background="Transparent" BorderThickness="0" Padding="0"
                                                     FontSize="13" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                        <TextBox x:Name="VisibleConfirmPasswordInput" 
                                                 Background="Transparent" BorderThickness="0" Padding="0"
                                                 FontSize="13" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Office Finance Subscription Promotion Section (Compact & Attractive) -->
                        <Border Background="{DynamicResource CardBrush}" 
                                BorderBrush="#FF3B30" 
                                BorderThickness="1" 
                                CornerRadius="10" 
                                Padding="12,10" 
                                Margin="0,2,0,4">
                            <Border.Effect>
                                <DropShadowEffect Color="#FF3B30" BlurRadius="10" Opacity="0.15" ShadowDepth="0"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Background="#25FF3B30" CornerRadius="4" Padding="5,1" Margin="0,0,6,0">
                                        <TextBlock Text="★ PREMIUM" Foreground="#FF3B30" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="Unlock Office Finance Management" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" 
                                           Text="Access advanced tools for office income, expenses, budgets, transactions and financial reports." 
                                           Foreground="{DynamicResource TextMutedBrush}" 
                                           FontSize="10.5" 
                                           TextWrapping="Wrap" 
                                           Margin="0,0,0,8"/>

                                <Button Grid.Row="2" 
                                        Content="SUBSCRIBE NOW" 
                                        Style="{StaticResource PremiumRedButtonStyle}" 
                                        Height="32" 
                                        FontSize="11" 
                                        FontWeight="Bold" 
                                        Padding="10,0"
                                        Command="{Binding OpenSubscriptionCommand}"/>
                            </Grid>
                        </Border>

                        <!-- Error Messages -->
                        <TextBlock Text="{Binding ErrorMessage}" 
                                   Foreground="{DynamicResource RedBrush}" 
                                   FontSize="11" 
                                   TextWrapping="Wrap" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,6,0,2"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Buttons Actions -->
                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button Content="CREATE ACCOUNT" 
                                Style="{StaticResource AccentButtonStyle}" 
                                Margin="0,0,0,8" 
                                Click="RegisterButton_Click"/>
                        
                        <Button Content="ALREADY HAVE AN ACCOUNT? LOG IN" 
                                Background="Transparent" 
                                Foreground="{DynamicResource TextMutedBrush}" 
                                FontWeight="Normal"
                                FontSize="11" 
                                BorderThickness="0" 
                                Cursor="Hand"
                                Command="{Binding NavigateLoginCommand}"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
