<Window x:Class="SmartFinanceManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:SmartFinanceManager.ViewModels"
        xmlns:views="clr-namespace:SmartFinanceManager.Views"
        Style="{StaticResource DarkWindowStyle}"
        Title="Smart Finance Manager" 
        Height="840" Width="1200"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <!-- Map ViewModels to Views -->
        <DataTemplate DataType="{x:Type viewmodels:PersonalDashboardViewModel}">
            <views:PersonalDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:OfficeDashboardViewModel}">
            <views:OfficeDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AdminDashboardViewModel}">
            <views:AdminDashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:AddTransactionViewModel}">
            <views:AddTransactionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ChartsViewModel}">
            <views:ChartsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:ProfileViewModel}">
            <views:ProfileView/>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="16" Background="{DynamicResource BackgroundBrush}" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Custom Titlebar for Dragging & Fullscreen -->
                <RowDefinition Height="*"/>    <!-- Page Content Control -->
                <RowDefinition Height="Auto"/> <!-- Bottom Navigation Zone -->
            </Grid.RowDefinitions>

            <!-- Custom drag-bar/header -->
            <Grid Grid.Row="0" Background="{DynamicResource NavigationBrush}" Height="42" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Smart Finance Manager" 
                               Foreground="{DynamicResource TextBrush}" 
                               FontSize="12" 
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <!-- Account Mode Badge -->
                    <Border Margin="10,0,0,0" 
                            Background="#1A007AFF" 
                            BorderBrush="{DynamicResource AccentBrush}" 
                            BorderThickness="1" 
                            CornerRadius="10" 
                            Padding="8,2">
                        <TextBlock Text="{Binding CurrentModeLabel}" 
                                   Foreground="{DynamicResource AccentBrush}" 
                                   FontSize="10" 
                                   FontWeight="SemiBold"/>
                    </Border>

                    <!-- Mode Switcher Quick Button -->
                    <Button Content="⇄ Switch Mode" 
                            Background="{DynamicResource CardSecondaryBrush}" 
                            Foreground="{DynamicResource TextMutedBrush}" 
                            FontSize="10" 
                            Padding="8,2" 
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" 
                            Cursor="Hand" 
                            Margin="8,0,0,0"
                            ToolTip="Switch between Personal and Office mode"
                            Command="{Binding SwitchModeCommand}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- Theme Toggle Quick Button -->
                    <Button Command="{Binding ToggleThemeCommand}" 
                            Background="{DynamicResource CardSecondaryBrush}" 
                            Foreground="{DynamicResource TextMutedBrush}" 
                            FontSize="10" 
                            Padding="8,2" 
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="1" 
                            Cursor="Hand" 
                            Margin="8,0,0,0"
                            ToolTip="Toggle Light / Dark mode">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{Binding CurrentThemeIcon, Converter={StaticResource StringToGeometryConverter}}" 
                                  Fill="{DynamicResource AccentBrush}" 
                                  Width="10" Height="10" 
                                  Stretch="Uniform" 
                                  VerticalAlignment="Center" 
                                  Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding CurrentThemeLabel}" FontSize="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Admin Portal Button (Visible only to Admin) -->
                    <Button Content="🛡 ADMIN PORTAL" 
                            Background="#25FF3B30" 
                            Foreground="#FF3B30" 
                            FontWeight="Bold" 
                            FontSize="10" 
                            Padding="8,2" 
                            BorderBrush="#FF3B30" 
                            BorderThickness="1" 
                            Cursor="Hand" 
                            Margin="8,0,0,0"
                            Visibility="{Binding IsAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Command="{Binding NavigateAdminCommand}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <TextBlock Text="{Binding FullName, StringFormat=• {0}}" 
                               Foreground="{DynamicResource TextMutedBrush}" 
                               FontSize="11" 
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Content="🗖" 
                            Background="Transparent" 
                            Foreground="{DynamicResource TextMutedBrush}" 
                            BorderThickness="0" 
                            FontSize="13" 
                            Margin="0,0,12,0"
                            Cursor="Hand"
                            Click="MaximizeButton_Click"/>
                    <Button Content="✕" 
                            Background="Transparent" 
                            Foreground="{DynamicResource TextMutedBrush}" 
                            BorderThickness="0" 
                            FontSize="14" 
                            Cursor="Hand"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Dynamic Content Control & Notification Overlay -->
            <Grid Grid.Row="1">
                <ContentControl Content="{Binding CurrentView}"/>

                <!-- In-App Floating Toast Notification Banner -->
                <Border HorizontalAlignment="Center" 
                        VerticalAlignment="Top" 
                        Margin="0,12,0,0" 
                        CornerRadius="10"
                        Padding="16,10"
                        BorderThickness="1"
                        Panel.ZIndex="999"
                        Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#1C2833"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsToastError}" Value="True">
                                    <Setter Property="Background" Value="#2D191E"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource RedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="16" Opacity="0.6" ShadowDepth="4"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" 
                              Data="{StaticResource IconCheck}" 
                              Fill="{DynamicResource GreenBrush}" 
                              Width="16" Height="16" 
                              Stretch="Uniform" 
                              VerticalAlignment="Center" 
                              Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding ToastMessage}" 
                                   Foreground="White" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2" 
                                Content="✕" 
                                Background="Transparent" 
                                Foreground="{DynamicResource TextMutedBrush}" 
                                BorderThickness="0" 
                                FontSize="11" 
                                Margin="12,0,0,0"
                                Cursor="Hand" 
                                Command="{Binding DismissToastCommand}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Navigation Bar (WPF Grid structure simulating mobile bar) -->
            <Border Grid.Row="2" 
                    Background="{DynamicResource NavigationBrush}" 
                    BorderThickness="0,1,0,0" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    Padding="0,8,0,12">
                <Grid Height="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/> <!-- Floating Space -->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Navigation Tabs -->
                    <RadioButton Grid.Column="0" 
                                 Content="Home" 
                                 Tag="{StaticResource IconHome}" 
                                 IsChecked="{Binding IsHomeActive, Mode=OneWay}"
                                 Command="{Binding NavigateHomeCommand}"
                                 Style="{StaticResource NavRadioButtonStyle}"/>

                    <RadioButton Grid.Column="1" 
                                 Content="Charts" 
                                 Tag="{StaticResource IconCharts}" 
                                 IsChecked="{Binding IsChartsActive, Mode=OneWay}"
                                 Command="{Binding NavigateChartsCommand}"
                                 Style="{StaticResource NavRadioButtonStyle}"/>

                    <!-- Centered Floating Add Button (+) -->
                    <Button Grid.Column="2" 
                            Style="{StaticResource FloatingAddButtonStyle}" 
                            VerticalAlignment="Center" 
                            HorizontalAlignment="Center"
                            Margin="0,-22,0,0"
                            Command="{Binding NavigateAddCommand}"/>

                    <RadioButton Grid.Column="3" 
                                 Content="Reports" 
                                 Tag="{StaticResource IconReports}" 
                                 IsChecked="{Binding IsReportsActive, Mode=OneWay}"
                                 Command="{Binding NavigateReportsCommand}"
                                 Style="{StaticResource NavRadioButtonStyle}"/>

                    <RadioButton Grid.Column="4" 
                                 Content="Profile" 
                                 Tag="{StaticResource IconProfile}" 
                                 IsChecked="{Binding IsProfileActive, Mode=OneWay}"
                                 Command="{Binding NavigateProfileCommand}"
                                 Style="{StaticResource NavRadioButtonStyle}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
