<Window x:Class="SmartFinanceManager.Views.Windows.SubscriptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:SmartFinanceManager.Helpers"
        mc:Ignorable="d"
        Style="{StaticResource DarkWindowStyle}"
        Title="Office Subscription - Smart Finance Manager" 
        Height="670" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Card Flip Animations -->
        <Storyboard x:Key="FlipToBackAnimation">
            <DoubleAnimation Storyboard.TargetName="FrontScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="0.0" Duration="0:0:0.18"
                             DecelerationRatio="0.5"/>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FrontCard"
                                          Storyboard.TargetProperty="Visibility"
                                          Duration="0:0:0.18">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}"/>
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackCard"
                                          Storyboard.TargetProperty="Visibility"
                                          Duration="0:0:0.18">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Visible}"/>
            </ObjectAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="BackScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.0" To="1.0" BeginTime="0:0:0.18" Duration="0:0:0.18"
                             AccelerationRatio="0.5"/>
        </Storyboard>

        <Storyboard x:Key="FlipToFrontAnimation">
            <DoubleAnimation Storyboard.TargetName="BackScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="0.0" Duration="0:0:0.18"
                             DecelerationRatio="0.5"/>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="BackCard"
                                          Storyboard.TargetProperty="Visibility"
                                          Duration="0:0:0.18">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Collapsed}"/>
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FrontCard"
                                          Storyboard.TargetProperty="Visibility"
                                          Duration="0:0:0.18">
                <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static Visibility.Visible}"/>
            </ObjectAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="FrontScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.0" To="1.0" BeginTime="0:0:0.18" Duration="0:0:0.18"
                             AccelerationRatio="0.5"/>
        </Storyboard>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundBrush}" 
            BorderBrush="{DynamicResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="16" 
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" Opacity="0.2" ShadowDepth="3"/>
        </Border.Effect>

        <Grid Margin="20,14,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#25FF3B30" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="★ PREMIUM UPGRADE" Foreground="#FF3B30" FontSize="9" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Smart Finance Manager" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Content="✕" 
                        HorizontalAlignment="Right" 
                        Width="24" Height="24" 
                        Background="Transparent" 
                        Foreground="{DynamicResource TextMutedBrush}" 
                        BorderThickness="0" 
                        FontSize="13" 
                        Cursor="Hand"
                        Click="CloseButton_Click"/>
            </Grid>

            <!-- Card Flip Container Area -->
            <Grid Grid.Row="1">

                <!-- ================= FRONT SIDE (OFFICE PROMOTION CARD) ================= -->
                <Border x:Name="FrontCard" 
                        Background="{DynamicResource CardBrush}" 
                        CornerRadius="14" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        Padding="20"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="FrontScale" ScaleX="1.0" ScaleY="1.0"/>
                    </Border.RenderTransform>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource RedBadgeBgBrush}" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Path Data="{StaticResource IconSparkles}" Fill="{DynamicResource RedBrush}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Office Finance Management" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Professional Business Accounting &amp; Tracking" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Feature Highlights Checklist -->
                        <Border Grid.Row="1" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                            <StackPanel VerticalAlignment="Center">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="✓" Foreground="#2ECC71" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Dedicated Office Financial Dashboard" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="18,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="✓" Foreground="#2ECC71" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Corporate Sales, Retainers &amp; Revenue Tracking" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="18,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="✓" Foreground="#2ECC71" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Office Rent, Payroll, Software &amp; Utility Expenses" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="18,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="✓" Foreground="#2ECC71" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Custom Monthly Budgets for Office Operations" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="18,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="✓" Foreground="#2ECC71" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="Corporate Financial Reports &amp; Analytics" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="18,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Price Tag Card -->
                        <Border Grid.Row="2" Background="{DynamicResource RedBadgeBgBrush}" BorderBrush="{DynamicResource RedBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="LIFETIME ACCESS FEE" Foreground="{DynamicResource RedBrush}" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock Text="One-time payment • No recurring charges" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="100" FontSize="26" FontWeight="ExtraBold" Foreground="{DynamicResource RedBrush}"/>
                                    <TextBlock Text=" BDT" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource RedBrush}" VerticalAlignment="Bottom" Margin="2,0,0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Action Button to Flip Card -->
                        <Button Grid.Row="3" 
                                Content="SUBSCRIBE NOW" 
                                Style="{StaticResource PremiumRedButtonStyle}" 
                                Height="42" 
                                FontSize="13" 
                                FontWeight="Bold"
                                Click="FlipToBack_Click"/>
                    </Grid>
                </Border>

                <!-- ================= BACK SIDE (SECURE PAYMENT CHECKOUT) ================= -->
                <Border x:Name="BackCard" 
                        Background="{DynamicResource CardBrush}" 
                        CornerRadius="14" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        Padding="20"
                        Visibility="Collapsed"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="BackScale" ScaleX="0.0" ScaleY="1.0"/>
                    </Border.RenderTransform>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header with Flip Back Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="SECURE CHECKOUT" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding Email, StringFormat='Account: {0}'}" 
                                           Foreground="{DynamicResource TextMutedBrush}" 
                                           FontSize="11" 
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Content="← Back" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Top"
                                    Background="Transparent" 
                                    Foreground="{DynamicResource TextMutedBrush}" 
                                    BorderThickness="0" 
                                    FontSize="12" 
                                    Cursor="Hand"
                                    Click="FlipToFront_Click"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- Recipient Number Card with Copy Button -->
                                <Border Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="SEND MONEY TO (BKASH):" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding RecipientNumber}" Foreground="{DynamicResource RedBrush}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0"/>
                                            <TextBlock Text="Amount: 100 BDT (One-Time Fee)" Foreground="{DynamicResource GreenBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" 
                                                Content="{Binding CopyButtonText}" 
                                                Background="{DynamicResource CardBrush}" 
                                                Foreground="{DynamicResource TextBrush}" 
                                                BorderThickness="1" 
                                                BorderBrush="{DynamicResource BorderBrush}" 
                                                Padding="12,6" 
                                                FontSize="12" 
                                                FontWeight="SemiBold"
                                                Cursor="Hand"
                                                VerticalAlignment="Center"
                                                Command="{Binding CopyRecipientNumberCommand}">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Step-by-Step Payment Instructions -->
                                <TextBlock Text="PAYMENT INSTRUCTIONS:" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold" Margin="2,0,0,4"/>
                                
                                <Border Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="1. Open your bKash App (or dial *247#)." Foreground="{DynamicResource TextBrush}" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBlock Text="2. Select the &quot;Send Money&quot; option." Foreground="{DynamicResource TextBrush}" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBlock Text="3. Send 100 BDT to 01903247467." Foreground="{DynamicResource RedBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBlock Text="4. Enter your bKash PIN to confirm transaction." Foreground="{DynamicResource TextBrush}" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBlock Text="5. Copy the Transaction ID from the SMS/Receipt." Foreground="{DynamicResource TextBrush}" FontSize="11.5" Margin="0,0,0,3"/>
                                        <TextBlock Text="6. Paste the ID below and click VERIFY." Foreground="{DynamicResource TextBrush}" FontSize="11.5"/>
                                    </StackPanel>
                                </Border>

                                <!-- Single Clean Transaction ID Input Card -->
                                <TextBlock Text="TRANSACTION ID" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold" Margin="2,0,0,4"/>
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="💳" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding TransactionId, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="Transparent" 
                                                 BorderThickness="0" 
                                                 Padding="0,6" 
                                                 FontSize="13.5" 
                                                 FontWeight="Bold"
                                                 Foreground="{DynamicResource TextBrush}" 
                                                 CaretBrush="{DynamicResource TextBrush}"/>
                                    </Grid>
                                </Border>

                                <!-- Error Message (Zero space when empty) -->
                                <TextBlock Text="{Binding ErrorMessage}" 
                                           Foreground="{DynamicResource RedBrush}" 
                                           FontSize="11" 
                                           TextWrapping="Wrap" 
                                           HorizontalAlignment="Center" 
                                           Margin="0,6,0,0"
                                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>

                                <!-- Success Message (Zero space when empty) -->
                                <TextBlock Text="{Binding SuccessMessage}" 
                                           Foreground="{DynamicResource GreenBrush}" 
                                           FontSize="11" 
                                           FontWeight="SemiBold" 
                                           TextWrapping="Wrap" 
                                           HorizontalAlignment="Center" 
                                           Margin="0,6,0,0"
                                           Visibility="{Binding SuccessMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Verify Button -->
                        <Button Grid.Row="2" 
                                Content="VERIFY" 
                                Style="{StaticResource PremiumRedButtonStyle}" 
                                Height="40" 
                                FontSize="13" 
                                FontWeight="Bold"
                                Command="{Binding VerifyPaymentCommand}"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
