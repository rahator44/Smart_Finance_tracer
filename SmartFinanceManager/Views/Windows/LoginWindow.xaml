<Window x:Class="SmartFinanceManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DarkWindowStyle}"
        Title="Smart Finance Manager - Login" 
        Height="720" Width="420"
        MinWidth="380" MinHeight="620"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">
    
    <Border Background="{DynamicResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Titlebar with Drag / Maximize / Close -->
                <RowDefinition Height="*"/>    <!-- Centered Form Container -->
            </Grid.RowDefinitions>

            <!-- Window Header (Drag Bar + Maximize / Close) -->
            <Grid Grid.Row="0" Background="{DynamicResource NavigationBrush}" Height="42" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Smart Finance Manager" 
                           Foreground="{DynamicResource TextMutedBrush}" 
                           FontSize="11" 
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Content="🗖" 
                            Background="Transparent" 
                            Foreground="{DynamicResource TextMutedBrush}" 
                            BorderThickness="0" 
                            FontSize="13" 
                            Margin="0,0,12,0"
                            Cursor="Hand"
                            Click="MaximizeButton_Click"/>
                    <Button Content="✕" 
                            Background="Transparent" 
                            Foreground="{DynamicResource TextMutedBrush}" 
                            BorderThickness="0" 
                            FontSize="14" 
                            Cursor="Hand"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Centered Form Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid MaxWidth="400" Margin="24,16,24,20" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Quick Demo Selector (top) -->
                        <RowDefinition Height="Auto"/> <!-- Title / Header -->
                        <RowDefinition Height="Auto"/> <!-- Inputs Form -->
                        <RowDefinition Height="Auto"/> <!-- Footer / Actions -->
                    </Grid.RowDefinitions>

                    <!-- Account Mode Selection Card -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="10" Margin="0,0,0,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="SELECT ACCOUNT MODE" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="10" Margin="0,0,0,6"/>
                            
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" 
                                             Content="👤 Personal" 
                                             IsChecked="{Binding IsPersonalDemoSelected, Mode=TwoWay}"
                                             Command="{Binding SelectPersonalDemoCommand}"
                                             Style="{StaticResource TabRadioButtonStyle}"
                                             Height="32"
                                             FontSize="11"/>
                                <RadioButton Grid.Column="2" 
                                             Content="🏢 Office" 
                                             IsChecked="{Binding IsOfficeDemoSelected, Mode=TwoWay}"
                                             Command="{Binding SelectOfficeDemoCommand}"
                                             Style="{StaticResource TabRadioButtonStyle}"
                                             Height="32"
                                             FontSize="11"/>
                            </Grid>
                            
                            <Button Content="＋ Generate Custom Test Profile" 
                                    Command="{Binding ToggleAddSeedUserCommand}"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    BorderThickness="0"
                                    Height="24"
                                    FontSize="10"
                                    Cursor="Hand"
                                    HorizontalAlignment="Center"
                                    Margin="0,4,0,0"/>

                            <!-- Collapsible Generate Seed Profile Sub-Form -->
                            <StackPanel Visibility="{Binding IsAddingSeedUser, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Separator Background="{DynamicResource BorderBrush}" Margin="0,6,0,6"/>
                                
                                <TextBlock Text="Profile Display Name (Optional)" Style="{StaticResource SubtitleTextStyle}" FontSize="10" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding NewSeedName, UpdateSourceTrigger=PropertyChanged}" Height="26" Margin="0,0,0,6" Padding="4,2" FontSize="11"/>

                                <TextBlock Text="Select Account Type" Style="{StaticResource SubtitleTextStyle}" FontSize="10" Margin="0,0,0,4"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" Content="Personal" IsChecked="{Binding NewSeedType, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Personal}" Style="{StaticResource TabRadioButtonStyle}" Height="24" FontSize="10" HorizontalContentAlignment="Center"/>
                                    <RadioButton Grid.Column="2" Content="Office" IsChecked="{Binding NewSeedType, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Office}" Style="{StaticResource TabRadioButtonStyle}" Height="24" FontSize="10" HorizontalContentAlignment="Center"/>
                                </Grid>

                                <Button Content="GENERATE TEST PROFILE" 
                                        Command="{Binding CreateSeedUserCommand}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Background="{DynamicResource AccentBrush}"
                                        Height="28"
                                        FontSize="10"
                                        FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- App Logo / Title -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,2,0,10">
                        <Ellipse Fill="{DynamicResource AccentBrush}" Width="36" Height="36" Margin="0,0,0,6">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#007AFF" BlurRadius="10" Opacity="0.4" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="Smart Finance" 
                                   Foreground="{DynamicResource TextBrush}" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Manager" 
                                   Foreground="{DynamicResource AccentBrush}" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Inputs Grid with Structured Cards -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Center">
                        <!-- Email Structured Card -->
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="✉" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="EMAIL ADDRESS" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="Transparent" BorderThickness="0" Padding="0" 
                                             FontSize="13" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Password Structured Card with Eye Toggle -->
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="🔒" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="PASSWORD" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                                    <Grid>
                                        <PasswordBox x:Name="PasswordInput" 
                                                     Background="Transparent" BorderThickness="0" Padding="0"
                                                     FontSize="13" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                                     Visibility="{Binding IsPasswordVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                        <TextBox x:Name="VisiblePasswordInput" 
                                                 Background="Transparent" BorderThickness="0" Padding="0"
                                                 FontSize="13" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                                 Visibility="{Binding IsPasswordVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </Grid>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Content="👁" 
                                        Click="TogglePassword_Click" 
                                        VerticalAlignment="Center" 
                                        Background="Transparent" 
                                        Foreground="{DynamicResource TextMutedBrush}" 
                                        BorderThickness="0" 
                                        FontSize="14" 
                                        Margin="4,0,0,0"
                                        Cursor="Hand"
                                        ToolTip="Toggle Password Visibility"/>
                            </Grid>
                        </Border>

                        <!-- Remember Me Row -->
                        <Grid Margin="0,0,0,8">
                            <CheckBox Content="Remember me on this device" 
                                      IsChecked="{Binding RememberMe}" 
                                      Foreground="{DynamicResource TextMutedBrush}" 
                                      FontSize="11" 
                                      VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Status & Error Messages -->
                        <TextBlock Text="{Binding ErrorMessage}" 
                                   Foreground="{DynamicResource RedBrush}" 
                                   FontSize="11" 
                                   TextWrapping="Wrap" 
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,2"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- Buttons Actions -->
                    <StackPanel Grid.Row="3" Margin="0,10,0,5">
                        <Button Content="LOG IN" 
                                Style="{StaticResource AccentButtonStyle}" 
                                Margin="0,0,0,8" 
                                Click="LoginButton_Click"/>
                
                        <Button Content="CREATE NEW ACCOUNT" 
                                Background="Transparent" 
                                Foreground="{DynamicResource AccentBrush}" 
                                FontWeight="SemiBold"
                                FontSize="12" 
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding NavigateRegisterCommand}"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
