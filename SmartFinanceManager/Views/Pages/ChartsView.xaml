<UserControl x:Class="SmartFinanceManager.Views.ChartsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SmartFinanceManager.Helpers"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.RenderTransform>
        <TranslateTransform Y="15"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="15" To="0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="24,14,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar & Month Navigator -->
            <RowDefinition Height="Auto"/> <!-- Smart Insight Banner -->
            <RowDefinition Height="*"/>    <!-- Main Live Visual Comparison Hub -->
        </Grid.RowDefinitions>

        <!-- Top Header & Month Switcher -->
        <Grid Grid.Row="0" Margin="0,4,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Cash Flow Live Comparison" Style="{StaticResource TitleTextStyle}" FontSize="22"/>
                <TextBlock Text="Live interactive visual comparison between Income (Blue) and Expenses (Red)" Style="{StaticResource SubtitleTextStyle}" FontSize="12"/>
            </StackPanel>

            <!-- Month Navigator Carousel -->
            <Border Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource CardSecondaryBrush}" CornerRadius="10" Padding="4,2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding PreviousMonthCommand}" 
                            Style="{StaticResource MonthNavButtonStyle}" 
                            ToolTip="Previous Month">
                        <Path Data="{StaticResource IconArrowLeft}" Fill="{DynamicResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>

                    <ComboBox ItemsSource="{Binding MonthOptions}" 
                              SelectedItem="{Binding SelectedMonth}" 
                              Style="{StaticResource MonthComboBoxStyle}"
                              Margin="4,0"
                              VerticalAlignment="Center"/>

                    <Button Command="{Binding NextMonthCommand}" 
                            Style="{StaticResource MonthNavButtonStyle}" 
                            ToolTip="Next Month">
                        <Path Data="{StaticResource IconArrowRight}" Fill="{DynamicResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Smart Insight Banner -->
        <Border Grid.Row="1" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16" MaxWidth="720" HorizontalAlignment="Center">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource IconSparkles}" Fill="#007AFF" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding ChartInsight}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Live Visual Comparison Hub -->
        <Grid Grid.Row="2" MaxWidth="720" HorizontalAlignment="Center">
            <!-- Empty State (When no transactions exist for the selected month) -->
            <Border Style="{StaticResource EmptyStateContainerStyle}" 
                    Visibility="{Binding HasData, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconCharts}" Fill="{DynamicResource TextMutedBrush}" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                    <TextBlock Text="No Financial Records Found" Foreground="{DynamicResource TextBrush}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="There are no income or expense transactions recorded for the selected month." 
                               Style="{StaticResource SubtitleTextStyle}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Active Live Visualizer View -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" Margin="0,4,0,20">

                    <!-- Visual Section 1: Dynamic 2-Data Pie Chart (Blue Income & Red Expense) -->
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24,20" Margin="0,0,0,16" Width="520">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Pie Chart Title & Mode -->
                            <Grid Width="460" Margin="0,0,0,14">
                                <TextBlock Text="PROPORTIONAL DISTRIBUTION" Style="{StaticResource SubtitleTextStyle}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right" Background="{DynamicResource CardSecondaryBrush}" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="{Binding SelectedMonthLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <!-- Pie Chart Canvas -->
                            <Canvas Width="260" Height="260" HorizontalAlignment="Center" Margin="0,0,0,14">
                                <!-- Background circular shadow -->
                                <Ellipse Width="226" Height="226" Canvas.Left="17" Canvas.Top="17" Fill="{DynamicResource CardSecondaryBrush}" Opacity="0.5"/>

                                <!-- Income Slice (Blue #007AFF) -->
                                <Path Data="{Binding IncomeSlicePathData}" 
                                      Fill="#007AFF" 
                                      Stroke="White" 
                                      StrokeThickness="2.5"
                                      StrokeLineJoin="Round"
                                      Visibility="{Binding HasIncomeData, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- Expense Slice (Red #FF3B30) -->
                                <Path Data="{Binding ExpenseSlicePathData}" 
                                      Fill="#FF3B30" 
                                      Stroke="White" 
                                      StrokeThickness="2.5"
                                      StrokeLineJoin="Round"
                                      Visibility="{Binding HasExpenseData, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <!-- Income Percentage Label inside Blue Slice -->
                                <Border Canvas.Left="{Binding IncomeLabelX}" 
                                        Canvas.Top="{Binding IncomeLabelY}" 
                                        Width="60" Height="24" 
                                        Visibility="{Binding ShowIncomeLabel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding IncomePercentageText}" 
                                               Foreground="White" 
                                               FontSize="15" 
                                               FontWeight="Bold" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.9"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Border>

                                <!-- Expense Percentage Label inside Red Slice -->
                                <Border Canvas.Left="{Binding ExpenseLabelX}" 
                                        Canvas.Top="{Binding ExpenseLabelY}" 
                                        Width="60" Height="24" 
                                        Visibility="{Binding ShowExpenseLabel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding ExpensePercentageText}" 
                                               Foreground="White" 
                                               FontSize="14" 
                                               FontWeight="Bold" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="Black" Opacity="0.9"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Border>
                            </Canvas>

                            <!-- Slices Legend -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,32,0" VerticalAlignment="Center">
                                    <Ellipse Width="12" Height="12" Fill="#007AFF" Margin="0,0,8,0"/>
                                    <TextBlock Text="Income" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding IncomePercentageText, StringFormat=' ({0})'}" Foreground="#64D2FF" FontWeight="Bold" FontSize="13"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="12" Height="12" Fill="#FF3B30" Margin="0,0,8,0"/>
                                    <TextBlock Text="Expenses" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding ExpensePercentageText, StringFormat=' ({0})'}" Foreground="#FF8A80" FontWeight="Bold" FontSize="13"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Visual Section 2: Live Inflow vs Outflow Dual Pillars & Split Bar -->
                    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24,20" Margin="0,0,0,16" Width="520">
                        <StackPanel>
                            <!-- Section Title -->
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="LIVE COMPARATIVE CASH FLOW" Style="{StaticResource SubtitleTextStyle}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right" Background="#26007AFF" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="{Binding CoverageRatioText}" Foreground="#007AFF" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <!-- Dual Comparative Pillars Diagram -->
                            <Grid Height="140" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>   <!-- Blue Income Pillar -->
                                    <ColumnDefinition Width="130"/> <!-- Center Comparison Bridge -->
                                    <ColumnDefinition Width="*"/>   <!-- Red Expense Pillar -->
                                </Grid.ColumnDefinitions>

                                <!-- Income Pillar (Blue #007AFF) -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding TotalIncome, Converter={StaticResource CurrencyAbsFormatter}}" 
                                               Foreground="#007AFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <Border Width="68" Height="{Binding IncomeBarHeight}" Background="#007AFF" CornerRadius="8,8,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#007AFF" Opacity="0.4"/>
                                        </Border.Effect>
                                    </Border>
                                    <TextBlock Text="INCOME" Foreground="#82B1FF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>

                                <!-- Center Comparative Bridge & Multiplier -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,6" Margin="0,0,0,6">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding SurplusBadgeText}" Foreground="#2ECC71" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding CoverageRatioText}" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding CoverageSubtext}" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>

                                <!-- Expense Pillar (Red #FF3B30) -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding TotalExpenses, Converter={StaticResource CurrencyAbsFormatter}}" 
                                               Foreground="#FF3B30" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                    <Border Width="68" Height="{Binding ExpenseBarHeight}" Background="#FF3B30" CornerRadius="8,8,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#FF3B30" Opacity="0.4"/>
                                        </Border.Effect>
                                    </Border>
                                    <TextBlock Text="EXPENSES" Foreground="#FF8A80" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Live Split Spectrum Bar (Continuous Comparison Track) -->
                            <StackPanel Margin="0,4,0,0">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="INCOME SHARE" Foreground="#007AFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Left"/>
                                    <TextBlock Text="EXPENSE SHARE" Foreground="#FF3B30" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                
                                <Border Height="18" Background="{DynamicResource CardSecondaryBrush}" CornerRadius="9" ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Income Segment (Blue) -->
                                        <Border Width="{Binding IncomeVisualWidth}" Height="18" Background="#007AFF"/>
                                        <!-- Expense Segment (Red) -->
                                        <Border Width="{Binding ExpenseVisualWidth}" Height="18" Background="#FF3B30"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Visual Section 3: Core 2-Data Summary KPI Cards -->
                    <Grid Width="520" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total Income Card (Blue) -->
                        <Border Grid.Column="0" Background="{DynamicResource AccentGlowBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="12" Padding="18,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#007AFF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="TOTAL INCOME" Foreground="#82B1FF" FontSize="10" FontWeight="Bold"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#26007AFF" CornerRadius="8" Padding="6,2">
                                        <TextBlock Text="{Binding IncomePercentageText}" Foreground="#007AFF" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding TotalIncome, Converter={StaticResource CurrencyAbsFormatter}}" 
                                           Foreground="#007AFF" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Expense Card (Red) -->
                        <Border Grid.Column="2" Background="{DynamicResource RedBadgeBgBrush}" BorderBrush="{DynamicResource RedBrush}" BorderThickness="1.5" CornerRadius="12" Padding="18,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#FF3B30" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="TOTAL EXPENSES" Foreground="#FF8A80" FontSize="10" FontWeight="Bold"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#26FF3B30" CornerRadius="8" Padding="6,2">
                                        <TextBlock Text="{Binding ExpensePercentageText}" Foreground="#FF3B30" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding TotalExpenses, Converter={StaticResource CurrencyAbsFormatter}}" 
                                           Foreground="#FF3B30" FontSize="20" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Net Balance & Monthly Retention Card -->
                    <Border Width="520" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="NET MONTHLY CASH FLOW" Style="{StaticResource SubtitleTextStyle}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding NetBalance, Converter={StaticResource AmountFormatter}}" 
                                           Foreground="{Binding NetBalance, Converter={StaticResource AmountToBrush}}" 
                                           FontSize="22" 
                                           FontWeight="Bold" 
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border Background="{DynamicResource CardSecondaryBrush}" CornerRadius="8" Padding="12,6" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SavingsRateLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="{Binding TotalTransfers, Converter={StaticResource CurrencyAbsFormatter}, StringFormat='Transfers: {0}'}" 
                                           Foreground="#007AFF" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,4,0,0"
                                           Visibility="{Binding HasTransfers, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
