<!-- [Rahat Component] Promotional subscription banner and upgrade flow -->
<UserControl x:Class="SmartFinanceManager.Views.PersonalDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SmartFinanceManager.Helpers"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.RenderTransform>
        <TranslateTransform Y="15"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="15" To="0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="20,10,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar & Month Navigation -->
            <RowDefinition Height="Auto"/> <!-- Office Subscription Promo / Pending Banner -->
            <RowDefinition Height="Auto"/> <!-- Budget Status Warning Banner -->
            <RowDefinition Height="Auto"/> <!-- Financial Stats Summary Cards -->
            <RowDefinition Height="Auto"/> <!-- Smart Insight Card -->
            <RowDefinition Height="Auto"/> <!-- Search & Category Filters -->
            <RowDefinition Height="*"/>    <!-- Transaction Cards List / Empty State -->
        </Grid.RowDefinitions>

        <!-- Top Header & Month Switcher -->
        <Grid Grid.Row="0" Margin="0,4,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Personal Finances" Style="{StaticResource TitleTextStyle}" FontSize="22"/>
                <TextBlock Text="Track your spending and income" Style="{StaticResource SubtitleTextStyle}" FontSize="11"/>
            </StackPanel>

            <!-- Month Navigator Carousel -->
            <Border Grid.Column="1" HorizontalAlignment="Center" Background="{DynamicResource CardSecondaryBrush}" CornerRadius="10" Padding="4,2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding PreviousMonthCommand}" 
                            Style="{StaticResource MonthNavButtonStyle}" 
                            ToolTip="Previous Month">
                        <Path Data="{StaticResource IconArrowLeft}" Fill="{DynamicResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>

                    <ComboBox ItemsSource="{Binding MonthOptions}" 
                              SelectedItem="{Binding SelectedMonth}" 
                              Style="{StaticResource MonthComboBoxStyle}"
                              Margin="4,0"
                              VerticalAlignment="Center"/>

                    <Button Command="{Binding NextMonthCommand}" 
                            Style="{StaticResource MonthNavButtonStyle}" 
                            ToolTip="Next Month">
                        <Path Data="{StaticResource IconArrowRight}" Fill="{DynamicResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Action Controls: Theme Switcher & Quick Add Shortcut -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Theme Toggle Button (Home Page Personal) -->
                <Button Command="{Binding ToggleThemeCommand}" 
                        Style="{StaticResource ThemeToggleButtonStyle}"
                        ToolTip="Switch between Light and Dark mode"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{Binding CurrentThemeIcon, Converter={StaticResource StringToGeometryConverter}}" 
                              Fill="{DynamicResource AccentBrush}" 
                              Width="14" Height="14" 
                              Stretch="Uniform" 
                              VerticalAlignment="Center" 
                              Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding CurrentThemeLabel}" 
                                   Foreground="{DynamicResource TextBrush}" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Quick Add Shortcut -->
                <Button Content="+ Add New" 
                        Style="{StaticResource AccentButtonStyle}" 
                        Height="32" 
                        Padding="14,0" 
                        FontSize="12"
                        Command="{Binding AddTransactionNavCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Office Subscription Promotional / Status Banner (Compact & Unobtrusive) -->
        <Border Grid.Row="1" 
                Visibility="{Binding IsOfficePromoVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="{DynamicResource CardSecondaryBrush}" 
                BorderBrush="#FF3B30" 
                BorderThickness="1" 
                CornerRadius="10" 
                Padding="14,9" 
                Margin="0,0,0,10">
            <Border.Effect>
                <DropShadowEffect Color="#FF3B30" BlurRadius="10" Opacity="0.15" ShadowDepth="0"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#25FF3B30" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconSparkles}" Fill="#FF3B30" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Normal Promo Content (When not pending) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="{Binding IsOfficePromoPending, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Unlock Office Finance Management" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="13"/>
                        <Border Background="#252ECC71" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                            <TextBlock Text="100 BDT (One-Time)" Foreground="#2ECC71" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Get access to Office Finance Management, budgets, reports and business transaction tracking." 
                               Foreground="{DynamicResource TextMutedBrush}" 
                               FontSize="11" 
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Pending Status Content (When request is under review) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="{Binding IsOfficePromoPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏳ Office Subscription Pending" Foreground="#FF9500" FontWeight="Bold" FontSize="13"/>
                        <Border Background="#25FF9500" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                            <TextBlock Text="Awaiting Administrator Approval" Foreground="#FF9500" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Your payment verification has been submitted and is under administrator review." 
                               Foreground="{DynamicResource TextMutedBrush}" 
                               FontSize="11" 
                               Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" 
                        Content="Subscribe Now"
                        Style="{StaticResource PremiumRedButtonStyle}" 
                        Height="30" 
                        Padding="12,0" 
                        FontSize="11" 
                        FontWeight="Bold"
                        VerticalAlignment="Center"
                        Command="{Binding OpenSubscriptionCommand}"/>
            </Grid>
        </Border>

        <!-- Active Budget Status Alert Banner -->
        <Border Grid.Row="2" 
                Margin="0,0,0,10" 
                CornerRadius="10" 
                Padding="14,8"
                BorderThickness="1"
                BorderBrush="{Binding BudgetStatus.Health, Converter={StaticResource BudgetHealthToColorConverter}}"
                Background="{Binding BudgetStatus.Health, Converter={StaticResource BudgetHealthToBgConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" 
                      Data="{StaticResource IconWarning}" 
                      Fill="{Binding BudgetStatus.Health, Converter={StaticResource BudgetHealthToColorConverter}}" 
                      Width="16" Height="16" 
                      Stretch="Uniform" 
                      VerticalAlignment="Center" 
                      Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" 
                           Text="{Binding BudgetStatus.StatusMessage}" 
                           Foreground="{Binding BudgetStatus.Health, Converter={StaticResource BudgetHealthToTextColorConverter}}" 
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" 
                           Text="{Binding BudgetStatus.TargetAmount, StringFormat=Budget: ${0:N0}}" 
                           Foreground="{DynamicResource TextMutedBrush}" 
                           FontSize="11" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- KPI Financial Summary Cards (Income, Expenses, Transfers, Net Balance) -->
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Income Card -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="24" Height="24" CornerRadius="12" Background="#202ECC71" Margin="0,0,6,0">
                            <Path Data="{StaticResource IconTrendUp}" Fill="{DynamicResource GreenBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Total Income" Style="{StaticResource SubtitleTextStyle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TotalIncome, Converter={StaticResource CurrencyAbsFormatter}}" 
                               Foreground="{DynamicResource GreenBrush}" 
                               FontSize="20" 
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Total Expenses Card -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="24" Height="24" CornerRadius="12" Background="#20FF3B30" Margin="0,0,6,0">
                            <Path Data="{StaticResource IconTrendDown}" Fill="{DynamicResource RedBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Total Expenses" Style="{StaticResource SubtitleTextStyle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TotalExpenses, Converter={StaticResource CurrencyAbsFormatter}}" 
                               Foreground="{DynamicResource RedBrush}" 
                               FontSize="20" 
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Transfers Card -->
            <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="24" Height="24" CornerRadius="12" Background="#20007AFF" Margin="0,0,6,0">
                            <Path Data="{StaticResource IconInvestment}" Fill="{DynamicResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Transfers/Invest" Style="{StaticResource SubtitleTextStyle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TotalTransfers, Converter={StaticResource CurrencyAbsFormatter}}" 
                               Foreground="{DynamicResource AccentBrush}" 
                               FontSize="20" 
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Net Liquid Balance Card -->
            <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}" Padding="16,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource CardSecondaryBrush}" Margin="0,0,6,0">
                            <Path Data="{StaticResource IconCreditCard}" Fill="{DynamicResource TextBrush}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Liquid Balance" Style="{StaticResource SubtitleTextStyle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Balance, Converter={StaticResource AmountFormatter}}" 
                               Foreground="{Binding Balance, Converter={StaticResource AmountToBrush}}" 
                               FontSize="20" 
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Smart Financial Heuristic Insight Card -->
        <Border Grid.Row="4" 
                Background="{DynamicResource CardSecondaryBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="12,8" 
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource IconSparkles}" Fill="{DynamicResource OrangeBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FinancialInsight}" Foreground="{DynamicResource TextBrush}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Transaction Feed Filters & Real-time Search Box -->
        <Grid Grid.Row="5" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Type Filter Tabs (All, Expense, Income, Transfer) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <RadioButton Content="All" IsChecked="{Binding IsAllFilterSelected}" Command="{Binding SetFilterCommand}" CommandParameter="All" Style="{StaticResource TabRadioButtonStyle}" Margin="0,0,4,0"/>
                <RadioButton Content="Expenses" IsChecked="{Binding IsExpenseFilterSelected}" Command="{Binding SetFilterCommand}" CommandParameter="Expense" Style="{StaticResource TabRadioButtonStyle}" Margin="0,0,4,0"/>
                <RadioButton Content="Income" IsChecked="{Binding IsIncomeFilterSelected}" Command="{Binding SetFilterCommand}" CommandParameter="Income" Style="{StaticResource TabRadioButtonStyle}" Margin="0,0,4,0"/>
                <RadioButton Content="Transfers" IsChecked="{Binding IsTransferFilterSelected}" Command="{Binding SetFilterCommand}" CommandParameter="Transfer" Style="{StaticResource TabRadioButtonStyle}"/>
            </StackPanel>

            <!-- Search Filter Field -->
            <Border Grid.Column="1" Background="{DynamicResource CardSecondaryBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8,4" Width="200">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox Grid.Column="1" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Background="Transparent" 
                             BorderThickness="0" 
                             Padding="0" 
                             FontSize="12" 
                             Foreground="{DynamicResource TextBrush}" 
                             CaretBrush="{DynamicResource TextBrush}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Dynamic List of Transactions (with Slide-out Edit & Delete actions) -->
        <Grid Grid.Row="6">
            <!-- Empty State Illustration -->
            <Border Background="{DynamicResource CardBrush}" 
                    CornerRadius="12" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    Padding="32" 
                    Visibility="{Binding HasTransactions, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconBill}" Fill="{DynamicResource TextMutedBrush}" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No transactions recorded for this period" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Click '+ Add New' above to record income or expenses" Style="{StaticResource SubtitleTextStyle}" HorizontalAlignment="Center" Margin="0,4,0,16"/>
                    <Button Content="+ Add First Transaction" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Command="{Binding AddTransactionNavCommand}"/>
                </StackPanel>
            </Border>

            <!-- Transaction Feed ListBox -->
            <ListBox ItemsSource="{Binding Transactions}" 
                     Background="Transparent" 
                     BorderThickness="0" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Visibility="{Binding HasTransactions, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,10" Name="ItemBorder">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/> <!-- Slide drawer column -->
                                </Grid.ColumnDefinitions>

                                <!-- Circular Category Icon -->
                                <Border Grid.Column="0" 
                                        Width="42" Height="42" 
                                        CornerRadius="21" 
                                        Background="{Binding Category, Converter={StaticResource CategoryToColor}}">
                                    <Path Data="{Binding Category, Converter={StaticResource StringToGeometryConverter}}" 
                                          Fill="#FFFFFF" 
                                          Width="18" Height="18" 
                                          Stretch="Uniform" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                                </Border>

                                <!-- Name, Date and Description details -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Category}" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold"/>
                                        <Border Margin="8,0,0,0" CornerRadius="4" Background="{Binding Type, Converter={StaticResource TransactionTypeToBadgeBgConverter}}" Padding="6,1">
                                            <TextBlock Text="{Binding Type}" Foreground="{Binding Type, Converter={StaticResource TransactionTypeToBrushConverter}}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Date, StringFormat={}{0:dd MMM yyyy}}" Style="{StaticResource SubtitleTextStyle}" FontSize="11"/>
                                        <TextBlock Text="{Binding Description, StringFormat='  •  {0}'}" 
                                                   Style="{StaticResource SubtitleTextStyle}" 
                                                   FontSize="11" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   MaxWidth="300"
                                                   Visibility="{Binding Description, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Transaction Amount -->
                                <TextBlock Grid.Column="3" 
                                           Text="{Binding Amount, Converter={StaticResource AmountFormatter}}" 
                                           Foreground="{Binding Amount, Converter={StaticResource AmountToBrush}}" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           VerticalAlignment="Center"/>

                                <!-- Slide out inline Edit / Delete actions on item selection -->
                                <StackPanel Name="ActionDrawer" Grid.Column="4" Orientation="Horizontal" Margin="14,0,0,0" Visibility="Collapsed">
                                    <Button Content="Edit" 
                                            Background="{DynamicResource OrangeBrush}" 
                                            Foreground="White" 
                                            Width="56" Height="32" 
                                            FontWeight="SemiBold" 
                                            FontSize="11" 
                                            BorderThickness="0" 
                                            Cursor="Hand" 
                                            Margin="0,0,6,0"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="Delete" 
                                            Background="{DynamicResource RedBrush}" 
                                            Foreground="White" 
                                            Width="56" Height="32" 
                                            FontWeight="SemiBold" 
                                            FontSize="11" 
                                            BorderThickness="0" 
                                            Cursor="Hand"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="ActionDrawer" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
