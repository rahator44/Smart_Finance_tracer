<UserControl x:Class="SmartFinanceManager.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SmartFinanceManager.Helpers"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.RenderTransform>
        <TranslateTransform Y="15"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="15" To="0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="20,10,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar & Month Navigator -->
            <RowDefinition Height="*"/>    <!-- Scrollable Reports Content -->
        </Grid.RowDefinitions>

        <!-- Top Header & Month Switcher -->
        <Grid Grid.Row="0" Margin="0,4,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Budget &amp; Reports" Style="{StaticResource TitleTextStyle}" FontSize="22"/>
                <TextBlock Text="Monthly limits, burn rate &amp; trend analysis" Style="{StaticResource SubtitleTextStyle}" FontSize="11"/>
            </StackPanel>

            <!-- Month Navigator Carousel -->
            <Border Grid.Column="1" HorizontalAlignment="Right" Background="{DynamicResource CardSecondaryBrush}" CornerRadius="10" Padding="4,2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding PreviousMonthCommand}" 
                            Style="{StaticResource MonthNavButtonStyle}" 
                            ToolTip="Previous Month">
                        <Path Data="{StaticResource IconArrowLeft}" Fill="{DynamicResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>

                    <ComboBox ItemsSource="{Binding MonthOptions}" 
                              SelectedItem="{Binding SelectedMonth}" 
                              Style="{StaticResource MonthComboBoxStyle}"
                              Margin="4,0"
                              VerticalAlignment="Center"/>

                    <Button Command="{Binding NextMonthCommand}" 
                            Style="{StaticResource MonthNavButtonStyle}" 
                            ToolTip="Next Month">
                        <Path Data="{StaticResource IconArrowRight}" Fill="{DynamicResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Scrollable Report Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0">
            <StackPanel Margin="0,0,8,0" MaxWidth="780" HorizontalAlignment="Center">
                <!-- Dynamic Budget Status Alert Banner -->
                <Border Margin="0,0,0,16" 
                        CornerRadius="10" 
                        Padding="14,10"
                        BorderThickness="1"
                        BorderBrush="{Binding BudgetHealth, Converter={StaticResource BudgetHealthToColorConverter}}"
                        Background="{Binding BudgetHealth, Converter={StaticResource BudgetHealthToBgConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" 
                              Data="{StaticResource IconWarning}" 
                              Fill="{Binding BudgetHealth, Converter={StaticResource BudgetHealthToColorConverter}}" 
                              Width="16" Height="16" 
                              Stretch="Uniform" 
                              VerticalAlignment="Center" 
                              Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" 
                                   Text="{Binding BudgetStatusMessage}" 
                                   Foreground="{Binding BudgetHealth, Converter={StaticResource BudgetHealthToTextColorConverter}}" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Circular Progress Ring Card -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="16,20">
                    <Grid Height="200" HorizontalAlignment="Center">
                        <!-- Gray Outer Track Circle -->
                        <Ellipse Width="180" Height="180" Stroke="{DynamicResource BorderBrush}" StrokeThickness="16"/>
                        
                        <!-- Dynamic Active Progress Sector -->
                        <Ellipse Width="180" Height="180" 
                                 Stroke="{Binding BudgetHealth, Converter={StaticResource BudgetHealthToColorConverter}}" 
                                 StrokeThickness="16" 
                                 StrokeDashArray="{Binding RemainingPercentage, Converter={StaticResource PercentageToDashArrayConverter}, ConverterParameter='180,16'}"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

                        <!-- Central Info Text -->
                        <Border Width="148" Height="148" CornerRadius="74" Background="{DynamicResource CardBrush}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Remaining Budget" Style="{StaticResource SubtitleTextStyle}" FontSize="10" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Remaining, Converter={StaticResource AmountFormatter}}" 
                                           Foreground="{Binding Remaining, Converter={StaticResource AmountToBrush}}" 
                                           FontSize="22" 
                                           FontWeight="Bold" 
                                           Margin="0,2,0,0" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding RemainingPercentage, StringFormat={}{0:F0}% Left}" 
                                           Foreground="{Binding BudgetHealth, Converter={StaticResource BudgetHealthToColorConverter}}" 
                                           FontSize="13" 
                                           FontWeight="SemiBold" 
                                           Margin="0,2,0,0" 
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Spent vs Budget Limits Summary Card -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Limit Card -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="BUDGET LIMIT" Style="{StaticResource SubtitleTextStyle}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding BudgetLimit, Converter={StaticResource CurrencyAbsFormatter}}" 
                                       Foreground="{DynamicResource TextBrush}" 
                                       FontSize="20" 
                                       FontWeight="Bold"/>
                            <TextBlock Text="Monthly expense target limit" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Spent Card -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="ACTUAL SPENT" Style="{StaticResource SubtitleTextStyle}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Expenses, Converter={StaticResource CurrencyAbsFormatter}}" 
                                       Foreground="{DynamicResource RedBrush}" 
                                       FontSize="20" 
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding UsedPercentage, StringFormat='{}{0:F0}% of budget utilized'}" 
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Month-over-Month Comparison Trends -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="SPENDING TREND" Style="{StaticResource SubtitleTextStyle}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ExpensesDelta, Converter={StaticResource AmountFormatter}}" 
                                       Foreground="{DynamicResource RedBrush}" 
                                       FontSize="18" 
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding ExpensesChangePct, Converter={StaticResource TrendPercentageConverter}}" 
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="INCOME TREND" Style="{StaticResource SubtitleTextStyle}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding IncomeDelta, Converter={StaticResource AmountFormatter}}" 
                                       Foreground="{DynamicResource TextBrush}" 
                                       FontSize="18" 
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding IncomeChangePct, Converter={StaticResource TrendPercentageConverter}}" 
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Set/Update Monthly Budget Target -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="SET / ADJUST MONTHLY BUDGET" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,0,8"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="$" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,10,0"/>
                            <TextBox Grid.Column="1" 
                                     Text="{Binding BudgetInputText, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="{DynamicResource InputBackgroundBrush}" 
                                     BorderThickness="1" 
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     Padding="8,6" 
                                     FontSize="14" 
                                     FontWeight="Bold" 
                                     Foreground="{DynamicResource TextBrush}" 
                                     CaretBrush="{DynamicResource TextBrush}"/>
                        </Grid>

                        <Button Content="SAVE BUDGET TARGET" 
                                Style="{StaticResource AccentButtonStyle}" 
                                Height="36"
                                Command="{Binding SaveBudgetCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Category Spending Breakdown Progress Bars -->
                <Border Style="{StaticResource CardBorderStyle}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="CATEGORY SPENDING BREAKDOWN" Foreground="{DynamicResource TextBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,12"/>
                        <ItemsControl ItemsSource="{Binding CategoryBreakdown}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Category}" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PercentageOfTotal, StringFormat='{}{0:F0}%'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Spent, Converter={StaticResource CurrencyAbsFormatter}}" Foreground="{DynamicResource RedBrush}" FontSize="12" FontWeight="Bold"/>

                                        <ProgressBar Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" 
                                                     Value="{Binding PercentageOfTotal}" 
                                                     Maximum="100" 
                                                     Height="4" 
                                                     Background="{DynamicResource BorderBrush}" 
                                                     BorderThickness="0">
                                            <ProgressBar.Template>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Grid SnapsToDevicePixels="true">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                                                        <Border Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2"
                                                                Background="{Binding ColorBrush, Converter={StaticResource HexColorToBrush}}"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </ProgressBar.Template>
                                        </ProgressBar>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
