<UserControl x:Class="SmartFinanceManager.Views.OfficeDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SmartFinanceManager.Helpers"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.RenderTransform>
        <TranslateTransform Y="15"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="15" To="0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="20,10,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar & Month Navigation -->
            <RowDefinition Height="Auto"/> <!-- Corporate Budget Alert Banner -->
            <RowDefinition Height="Auto"/> <!-- 2x2 Financial Metrics Cards -->
            <RowDefinition Height="Auto"/> <!-- Smart Corporate Insight Banner -->
            <RowDefinition Height="Auto"/> <!-- Search & Filter Controls -->
            <RowDefinition Height="*"/>    <!-- Transaction List / Empty State -->
        </Grid.RowDefinitions>

        <!-- Top Header & Month Switcher -->
        <Grid Grid.Row="0" Margin="0,4,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Corporate Finances" Style="{StaticResource TitleTextStyle}" FontSize="22"/>
                <TextBlock Text="Enterprise revenue, operations &amp; cash flow" Style="{StaticResource SubtitleTextStyle}" FontSize="11"/>
            </StackPanel>

            <!-- Month Navigator Carousel -->
            <Border Grid.Column="1" HorizontalAlignment="Center" Background="{DynamicResource CardSecondaryBrush}" CornerRadius="10" Padding="4,2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding PreviousMonthCommand}" 
                            Style="{StaticResource MonthNavButtonStyle}" 
                            ToolTip="Previous Month">
                        <Path Data="{StaticResource IconArrowLeft}" Fill="{DynamicResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>

                    <ComboBox ItemsSource="{Binding MonthOptions}" 
                              SelectedItem="{Binding SelectedMonth}" 
                              Style="{StaticResource MonthComboBoxStyle}"
                              Margin="4,0"
                              VerticalAlignment="Center"/>

                    <Button Command="{Binding NextMonthCommand}" 
                            Style="{StaticResource MonthNavButtonStyle}" 
                            ToolTip="Next Month">
                        <Path Data="{StaticResource IconArrowRight}" Fill="{DynamicResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Action Controls: Theme Switcher & Quick Add Shortcut -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Theme Toggle Button (Home Page Office) -->
                <Button Command="{Binding ToggleThemeCommand}" 
                        Style="{StaticResource ThemeToggleButtonStyle}"
                        ToolTip="Switch between Light and Dark mode"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{Binding CurrentThemeIcon, Converter={StaticResource StringToGeometryConverter}}" 
                              Fill="{DynamicResource AccentBrush}" 
                              Width="14" Height="14" 
                              Stretch="Uniform" 
                              VerticalAlignment="Center" 
                              Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding CurrentThemeLabel}" 
                                   Foreground="{DynamicResource TextBrush}" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Quick Add Shortcut -->
                <Button Content="+ Add Entry" 
                        Style="{StaticResource AccentButtonStyle}" 
                        Height="32" 
                        Padding="14,0" 
                        FontSize="12"
                        Command="{Binding AddTransactionNavCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Corporate Budget Alert Banner -->
        <Border Grid.Row="1" 
                Margin="0,0,0,12" 
                CornerRadius="10" 
                Padding="14,10"
                BorderThickness="1"
                BorderBrush="{Binding BudgetStatus.Health, Converter={StaticResource BudgetHealthToColorConverter}}"
                Background="{Binding BudgetStatus.Health, Converter={StaticResource BudgetHealthToBgConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" 
                      Data="{StaticResource IconWarning}" 
                      Fill="{Binding BudgetStatus.Health, Converter={StaticResource BudgetHealthToColorConverter}}" 
                      Width="16" Height="16" 
                      Stretch="Uniform" 
                      VerticalAlignment="Center" 
                      Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" 
                           Text="{Binding BudgetStatus.StatusMessage}" 
                           Foreground="{Binding BudgetStatus.Health, Converter={StaticResource BudgetHealthToTextColorConverter}}" 
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" 
                           Text="{Binding BudgetStatus.TargetAmount, StringFormat=Target Burn: ${0:N0}}" 
                           Foreground="{DynamicResource TextMutedBrush}" 
                           FontSize="11" 
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 2x2 Corporate Financial Metrics Grid -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Revenue Card -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TOTAL REVENUE" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalRevenue, Converter={StaticResource CurrencyAbsFormatter}}" 
                                   Foreground="{DynamicResource GreenBrush}" 
                                   FontSize="22" 
                                   FontWeight="Bold"/>
                        <TextBlock Text="Product sales, retainers &amp; licensing" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                    <!-- Trend Badge -->
                    <Border Grid.Column="1" Background="{DynamicResource GreenBadgeBgBrush}" CornerRadius="6" Padding="6,2" VerticalAlignment="Top">
                        <TextBlock Text="{Binding RevenueTrendPct, Converter={StaticResource TrendPercentageConverter}}" 
                                   Foreground="{DynamicResource GreenBrush}" 
                                   FontSize="10" 
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Operating Expenses Card -->
            <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="OPERATING EXPENSES" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding TotalExpenses, Converter={StaticResource CurrencyAbsFormatter}}" 
                                   Foreground="{DynamicResource RedBrush}" 
                                   FontSize="22" 
                                   FontWeight="Bold"/>
                        <TextBlock Text="Payroll, lease, cloud &amp; taxes" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                    <!-- Trend Badge -->
                    <Border Grid.Column="1" Background="{DynamicResource RedBadgeBgBrush}" CornerRadius="6" Padding="6,2" VerticalAlignment="Top">
                        <TextBlock Text="{Binding ExpensesTrendPct, Converter={StaticResource TrendPercentageConverter}}" 
                                   Foreground="{DynamicResource RedBrush}" 
                                   FontSize="10" 
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Net Profit Card -->
            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="NET PROFIT (EBITDA)" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding NetProfit, Converter={StaticResource AmountFormatter}}" 
                               Foreground="{Binding NetProfit, Converter={StaticResource AmountToBrush}}" 
                               FontSize="22" 
                               FontWeight="Bold"/>
                    <TextBlock Text="Operating revenue minus expenses" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Net Cash Flow Card -->
            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="NET CASH FLOW" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding CashFlow, Converter={StaticResource AmountFormatter}}" 
                               Foreground="{Binding CashFlow, Converter={StaticResource AmountToBrush}}" 
                               FontSize="22" 
                               FontWeight="Bold"/>
                    <TextBlock Text="Net profit + treasury capital movements" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Smart Corporate Insight Banner -->
        <Border Grid.Row="3" Background="{DynamicResource CardSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource IconSparkles}" Fill="{DynamicResource AccentBrush}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding CorporateInsight}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Search & Filter Controls -->
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Live Search Box -->
            <Border Grid.Column="0" Background="{DynamicResource CardSecondaryBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{DynamicResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="2,0,8,0"/>
                    <TextBox Grid.Column="1" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Background="Transparent" 
                             BorderThickness="0" 
                             Foreground="{DynamicResource TextBrush}" 
                             CaretBrush="{DynamicResource TextBrush}" 
                             FontSize="12"
                             VerticalAlignment="Center"/>
                    <Button Grid.Column="2" 
                            Content="✕" 
                            Background="Transparent" 
                            Foreground="{DynamicResource TextMutedBrush}" 
                            BorderThickness="0" 
                            FontSize="10" 
                            Cursor="Hand"
                            Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding SearchText, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- Filter Pills Row -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Content="All" 
                             GroupName="OfficeFilterGroup"
                             IsChecked="{Binding IsAllFilterSelected, Mode=TwoWay}" 
                             Command="{Binding SetFilterCommand}" 
                             CommandParameter="All" 
                             Style="{StaticResource FilterPillRadioButtonStyle}" 
                             Margin="0,0,6,0"/>
                <RadioButton Content="Revenue" 
                             GroupName="OfficeFilterGroup"
                             IsChecked="{Binding IsIncomeFilterSelected, Mode=TwoWay}" 
                             Command="{Binding SetFilterCommand}" 
                             CommandParameter="Income" 
                             Style="{StaticResource FilterPillRadioButtonStyle}" 
                             Margin="0,0,6,0"/>
                <RadioButton Content="Expenses" 
                             GroupName="OfficeFilterGroup"
                             IsChecked="{Binding IsExpenseFilterSelected, Mode=TwoWay}" 
                             Command="{Binding SetFilterCommand}" 
                             CommandParameter="Expense" 
                             Style="{StaticResource ExpenseFilterPillRadioButtonStyle}" 
                             Margin="0,0,6,0"/>
                <RadioButton Content="Treasury" 
                             GroupName="OfficeFilterGroup"
                             IsChecked="{Binding IsTransferFilterSelected, Mode=TwoWay}" 
                             Command="{Binding SetFilterCommand}" 
                             CommandParameter="Transfer" 
                             Style="{StaticResource FilterPillRadioButtonStyle}"/>
            </StackPanel>
        </Grid>

        <!-- Transaction List View / Empty State -->
        <Grid Grid.Row="5">
            <!-- Empty State Card -->
            <Border Style="{StaticResource EmptyStateContainerStyle}" 
                    Visibility="{Binding HasTransactions, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{StaticResource IconReports}" Fill="{DynamicResource TextMutedBrush}" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No Corporate Records Found" Foreground="{DynamicResource TextBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="There are no corporate records matching your search or month filter." 
                               Style="{StaticResource SubtitleTextStyle}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,14"/>
                    <Button Content="Add Transaction" Style="{StaticResource AccentButtonStyle}" Width="150" Height="34" Command="{Binding AddTransactionNavCommand}"/>
                </StackPanel>
            </Border>

            <!-- Transactions ListBox -->
            <ListBox ItemsSource="{Binding Transactions}" 
                     Background="Transparent" 
                     BorderThickness="0" 
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     HorizontalContentAlignment="Stretch"
                     Padding="0"
                     SelectionMode="Single"
                     Visibility="{Binding HasTransactions, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="12" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,10" Name="ItemBorder">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/> <!-- Slide drawer column -->
                                </Grid.ColumnDefinitions>

                                <!-- Circular Category Icon -->
                                <Border Grid.Column="0" 
                                        Width="42" Height="42" 
                                        CornerRadius="21" 
                                        Background="{Binding Category, Converter={StaticResource CategoryToColor}}">
                                    <Path Data="{Binding Category, Converter={StaticResource StringToGeometryConverter}}" 
                                          Fill="#FFFFFF" 
                                          Width="18" Height="18" 
                                          Stretch="Uniform" 
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                                </Border>

                                <!-- Name, Date and Description details -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Category}" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="SemiBold"/>
                                        <Border Margin="8,0,0,0" CornerRadius="4" Background="{Binding Type, Converter={StaticResource TransactionTypeToBadgeBgConverter}}" Padding="6,1">
                                            <TextBlock Text="{Binding Type}" Foreground="{Binding Type, Converter={StaticResource TransactionTypeToBrushConverter}}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Date, StringFormat={}{0:dd MMM yyyy}}" Style="{StaticResource SubtitleTextStyle}" FontSize="11"/>
                                        <TextBlock Text="{Binding Description, StringFormat='  •  {0}'}" 
                                                   Style="{StaticResource SubtitleTextStyle}" 
                                                   FontSize="11" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   MaxWidth="300"
                                                   Visibility="{Binding Description, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Transaction Amount -->
                                <TextBlock Grid.Column="3" 
                                           Text="{Binding Amount, Converter={StaticResource AmountFormatter}}" 
                                           Foreground="{Binding Amount, Converter={StaticResource AmountToBrush}}" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           VerticalAlignment="Center"/>

                                <!-- Slide out inline Edit / Delete actions on item selection -->
                                <StackPanel Name="ActionDrawer" Grid.Column="4" Orientation="Horizontal" Margin="14,0,0,0" Visibility="Collapsed">
                                    <Button Content="Edit" 
                                            Background="{DynamicResource OrangeBrush}" 
                                            Foreground="White" 
                                            Width="56" Height="32" 
                                            FontWeight="SemiBold"
                                            FontSize="11"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="0,0,6,0"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                    <Button Content="Delete" 
                                            Background="{DynamicResource RedBrush}" 
                                            Foreground="White" 
                                            Width="56" Height="32" 
                                            FontWeight="SemiBold"
                                            FontSize="11"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="ActionDrawer" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
