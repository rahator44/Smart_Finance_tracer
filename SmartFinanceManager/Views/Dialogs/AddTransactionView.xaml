<UserControl x:Class="SmartFinanceManager.Views.AddTransactionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SmartFinanceManager.Helpers"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.RenderTransform>
        <TranslateTransform Y="15"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="15" To="0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <UserControl.Resources>
        <Style x:Key="CategoryCardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,14,24,20" MaxWidth="720" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Header -->
                <RowDefinition Height="Auto"/> <!-- Preset Templates -->
                <RowDefinition Height="Auto"/> <!-- Tab Control Buttons (Expense/Income/Transfer) -->
                <RowDefinition Height="Auto"/> <!-- Smart Suggestion Notification -->
                <RowDefinition Height="Auto"/> <!-- Category Grid -->
                <RowDefinition Height="Auto"/> <!-- Inputs Panel -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{Binding TitleText}" Style="{StaticResource TitleTextStyle}" HorizontalAlignment="Center" FontSize="22"/>
            </Grid>

            <!-- Preset Templates Selector Panel -->
            <Border Grid.Row="1" Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="QUICK PRESET TEMPLATES" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="10" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding PresetTemplates}"
                                  SelectedItem="{Binding SelectedPresetTemplate}"
                                  DisplayMemberPath="DisplayName"
                                  Background="{DynamicResource InputBackgroundBrush}"
                                  Foreground="{DynamicResource TextBrush}"
                                  BorderThickness="1"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  Height="32"
                                  Padding="8,4"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Save as Preset"
                            Command="{Binding SaveAsPresetCommand}"
                            Background="{DynamicResource CardSecondaryBrush}"
                            Foreground="{DynamicResource TextBrush}"
                            BorderThickness="0"
                            Height="32"
                            Padding="12,0"
                            Margin="12,16,0,0"
                            VerticalAlignment="Bottom"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>

            <!-- Transaction Type Segmented Toggle -->
            <Border Grid.Row="2" Background="{DynamicResource CardSecondaryBrush}" CornerRadius="10" Padding="4" Margin="0,0,0,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <RadioButton Grid.Column="0" 
                                 GroupName="AddTransactionTypeRadioGroup"
                                 Content="{Binding ExpenseTabHeader}" 
                                 IsChecked="{Binding IsExpenseType, Mode=TwoWay}" 
                                 Style="{StaticResource ExpenseTabRadioButtonStyle}" 
                                 HorizontalContentAlignment="Center"/>

                    <RadioButton Grid.Column="1" 
                                 GroupName="AddTransactionTypeRadioGroup"
                                 Content="{Binding IncomeTabHeader}" 
                                 IsChecked="{Binding IsIncomeType, Mode=TwoWay}" 
                                 Style="{StaticResource TabRadioButtonStyle}" 
                                 HorizontalContentAlignment="Center"/>

                    <RadioButton Grid.Column="2" 
                                 GroupName="AddTransactionTypeRadioGroup"
                                 Content="{Binding TransferTabHeader}" 
                                 IsChecked="{Binding IsTransferType, Mode=TwoWay}" 
                                 Style="{StaticResource TabRadioButtonStyle}" 
                                 HorizontalContentAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Smart Suggestion Badge -->
            <Border Grid.Row="3" 
                    Margin="0,0,0,10" 
                    Background="#1A007AFF" 
                    BorderBrush="{DynamicResource AccentBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="10,6"
                    Visibility="{Binding SmartSuggestion, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconSparkles}" Fill="{DynamicResource AccentBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding SmartSuggestion}" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Category Grid Selection -->
            <Grid Grid.Row="4" Margin="0,0,0,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,0">
                    <TextBlock Text="Selected Category: " Style="{StaticResource SubtitleTextStyle}" FontSize="13"/>
                    <TextBlock Text="{Binding SelectedCategory}" Foreground="{Binding TransactionType, Converter={StaticResource TransactionTypeToBrushConverter}}" FontWeight="Bold" FontSize="14"/>
                </StackPanel>

                <ItemsControl Grid.Row="2" ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="12" Margin="3" Cursor="Hand">
                                <Border.BorderBrush>
                                    <MultiBinding Converter="{StaticResource CategorySelectedToBorderBrushConverter}">
                                        <Binding Path="DataContext.SelectedCategory" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        <Binding Path="Name"/>
                                        <Binding Path="DataContext.TransactionType" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        <Binding Path="DataContext.IsDarkTheme" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    </MultiBinding>
                                </Border.BorderBrush>
                                <Border.Background>
                                    <MultiBinding Converter="{StaticResource CategorySelectedToBackgroundConverter}">
                                        <Binding Path="DataContext.SelectedCategory" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        <Binding Path="Name"/>
                                        <Binding Path="DataContext.TransactionType" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        <Binding Path="DataContext.IsDarkTheme" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    </MultiBinding>
                                </Border.Background>
                                <Border.BorderThickness>
                                    <Thickness Left="1.5" Top="1.5" Right="1.5" Bottom="1.5"/>
                                </Border.BorderThickness>

                                <Button Style="{StaticResource CategoryCardButtonStyle}" 
                                        Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Name}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,10">
                                        <!-- Circular Icon: turns Red for Expense, Blue for Income/Transfer when clicked -->
                                        <Border Width="44" Height="44" CornerRadius="22" Margin="0,0,0,6" HorizontalAlignment="Center">
                                            <Border.Background>
                                                <MultiBinding Converter="{StaticResource CategorySelectionToCircleBrushConverter}">
                                                    <Binding Path="DataContext.SelectedCategory" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    <Binding Path="Name"/>
                                                    <Binding Path="DataContext.TransactionType" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    <Binding Path="DataContext.IsDarkTheme" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Border.Background>
                                            <Path Data="{Binding IconTag, Converter={StaticResource StringToGeometryConverter}}" 
                                                  Fill="#FFFFFF" 
                                                  Width="22" Height="22" 
                                                  Stretch="Uniform" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" 
                                                   Foreground="{DynamicResource TextBrush}" 
                                                   FontSize="11" 
                                                   FontWeight="SemiBold" 
                                                   HorizontalAlignment="Center" 
                                                   TextAlignment="Center" 
                                                   TextWrapping="Wrap" 
                                                   MaxWidth="110"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- Inputs Panel (Amount, Date, Description) -->
            <StackPanel Grid.Row="5" Margin="0,0,0,14">
                <!-- Amount Input Card -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="$" Foreground="{Binding TransactionType, Converter={StaticResource TransactionTypeToBrushConverter}}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="AMOUNT ($)" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" BorderThickness="0" Padding="0" 
                                     FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Date Card -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📅" FontSize="18" VerticalAlignment="Center" Margin="2,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="TRANSACTION DATE" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                            <DatePicker SelectedDate="{Binding Date, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                        Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0" Height="34" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Description Card -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,10" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📝" FontSize="16" VerticalAlignment="Center" Margin="2,0,10,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="NOTES / DESCRIPTION (TYPE KEYWORDS TO AUTO-CATEGORIZE)" Foreground="{DynamicResource TextMutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" BorderThickness="0" Padding="0" 
                                     FontSize="13" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Error message -->
                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="{DynamicResource RedBrush}" 
                           FontSize="12" 
                           HorizontalAlignment="Center" 
                           Margin="0,4,0,0"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Action Buttons -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Content="CANCEL" 
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="44"
                        Command="{Binding CancelCommand}"/>

                <Button Grid.Column="2" 
                        Content="SAVE TRANSACTION" 
                        Background="{Binding TransactionType, Converter={StaticResource TransactionTypeToBrushConverter}}"
                        Style="{StaticResource AccentButtonStyle}"
                        Height="44"
                        Command="{Binding SaveCommand}"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
